use primitives

const TableMegabytes = 2
const BucketSize = 4
const TableBuckets = (TableMegabytes << 20) / (BucketSize * 8)

enum Bound: u8
    NoBound = 0
    Upper = 1
    Lower = 2
    Exact = 3

packed TableEntry: u64
    key: u16
    move: Move
    score: i16
    depth: u8
    bound: Bound : 2
    age: u8 : 6

const NoEntry = 0 as TableEntry

var table_slots: [TableBuckets * BucketSize]u64

struct TranspositionTable
    generation: u64

    fn clear()
        zero(&table_slots[0], TableBuckets * BucketSize)

    fn new_search()
        generation = (generation + 1) & 63

    @inline
    fn bucket(hash: u64) -> *u64
        return &table_slots[0] + (hash & (TableBuckets - 1)) * BucketSize

    @inline
    fn preload(hash: u64)
        prefetch(bucket(hash))

    @inline
    fn probe(hash: u64) -> TableEntry
        let slots = bucket(hash)
        let key = hash >> 48
        for i in 0..BucketSize
            let data = slots[i]
            if data & 0xFFFF == key and data != 0: return data as TableEntry
        return NoEntry

    @nosave
    fn store(hash: u64, move: Move, score: int, depth: int, bound: Bound)
        let slots = bucket(hash)
        let key = hash >> 48
        var slot = slots
        var kept_move = move
        var worst = int.max
        for i in 0..BucketSize
            let data = slots[i]
            if data == 0 or data & 0xFFFF == key
                slot = slots + i
                if move == NoMove and data != 0: kept_move = (data as TableEntry).move
                break
            let age = (generation - (data >> 58)) & 63
            let value = (data >> 48 & 0xFF) as int - 8 * age as int
            if value < worst
                worst = value
                slot = slots + i
        *slot = TableEntry(key, kept_move, score, depth, bound, generation) as u64
