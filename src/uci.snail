use threads
use perft
use bench

const MaxWords = 1024

struct Uci
    board: *Board
    threads: *SearchThreads
    limits: SearchLimits
    search_thread: u64
    searching: bool
    searched_this_game: bool
    custom_position: bool
    game_ply: int

    fn stop_search()
        if not searching: return
        threads.stop()
        join(search_thread)
        searching = false

    fn start_search()
        threads.reset_stop()
        searching = true
        search_thread = spawn(run_uci_search, self)

fn run_uci_search(uci: *Uci)
    let threads = uci.threads
    let best = threads.choose_move(uci.board, uci.limits, uci.game_ply)
    if best == NoMove
        print("bestmove 0000")
        return
    write("bestmove ")
    write_move(best)
    if threads.last_line_length > 1
        write(" ponder ")
        write_move(threads.last_line[1])
    print()

fn print_version()
    print("{EngineName} {EngineVersion} by {EngineAuthor}")

fn uci_loop()
    let uci = new Uci
    uci.board = new Board
    uci.board.load_fen(StartFen)
    uci.threads = SearchThreads.create()
    uci.threads.set_threads(DefaultThreads)
    var words: [MaxWords]str = undefined

    loop
        let (line, ok) = read_line()
        if not ok: break
        let count = split_words(line, &words[0], MaxWords)
        if count == 0: continue
        let command = words[0]

        if command == "uci"
            print("id name {EngineName} {EngineVersion}")
            print("id author {EngineAuthor}")
            print("option name Threads type spin default {DefaultThreads} min 1 max {MaxThreads}")
            print("option name UCI_LimitStrength type check default false")
            print("option name UCI_Elo type spin default {DefaultStrengthElo} min {MinStrengthElo} max {MaxStrengthElo}")
            print("option name Style type combo default Balanced var Aggressive var Balanced var Passive")
            print("option name MasterBook type string default <empty>")
            print("option name GambitBook type string default <empty>")
            print("option name PassiveBook type string default <empty>")
            print("option name NeutralBook type string default <empty>")
            print("option name MemoryFile type string default <empty>")
            print("uciok")
        elif command == "isready"
            print("readyok")
        elif command == "ucinewgame"
            uci.stop_search()
            uci.threads.finish_game()
            uci.board.load_fen(StartFen)
            uci.threads.clear_hash()
            uci.searched_this_game = false
            uci.custom_position = false
        elif command == "setoption"
            uci.stop_search()
            set_option(uci.threads, line, &words[0], count)
        elif command == "position"
            uci.stop_search()
            let (custom, plies) = set_position(uci.board, line, &words[0], count)
            uci.custom_position = custom
            uci.game_ply = plies
        elif command == "go"
            uci.stop_search()
            if parse_go(uci, &words[0], count)
                uci.searched_this_game = true
                uci.start_search()
        elif command == "stop"
            uci.threads.stop()
        elif command == "bench"
            uci.stop_search()
            run_bench(count > 1 ? parse_int(words[1]) : DefaultBenchDepth)
        elif command == "version"
            print_version()
        elif command == "quit"
            break
    uci.stop_search()
    uci.threads.finish_game()

fn set_option(threads: *SearchThreads, line: str, words: *str, count: int)
    if count < 5 or words[1] != "name" or words[3] != "value": return
    let name = words[2]
    let text = words[4]
    let last = words[count - 1]
    let rest = line[words[4].ptr - line.ptr..last.ptr - line.ptr + last.len]
    let value = parse_int(text) as int
    if name == "Threads" or name == "threads": threads.set_threads(clamp(value, 1, MaxThreads))
    elif name == "UCI_LimitStrength": threads.strength.limited = text == "true"
    elif name == "UCI_Elo": threads.strength.elo = clamp(value, MinStrengthElo, MaxStrengthElo)
    elif name == "Style": threads.strength.style = text == "Aggressive" ? Aggressive : text == "Passive" ? Passive : Balanced
    elif name == "MasterBook": threads.opening.set_book(MasterLines, rest)
    elif name == "GambitBook": threads.opening.set_book(GambitLines, rest)
    elif name == "PassiveBook": threads.opening.set_book(PassiveLines, rest)
    elif name == "NeutralBook": threads.opening.set_book(NeutralLines, rest)
    elif name == "MemoryFile": threads.opening.memory.open(rest)

fn set_position(board: *Board, line: str, words: *str, count: int) -> (bool, int)
    var next = 2
    var custom = false
    if count > 1 and words[1] == "startpos"
        board.load_fen(StartFen)
    elif count > 1 and words[1] == "fen"
        while next < count and words[next] != "moves"
            next += 1
        if next == 2: return false, 0
        let start = words[2].ptr - line.ptr
        let last = words[next - 1]
        let end = last.ptr - line.ptr + last.len
        if not board.load_fen(line[start..end]): return false, 0
        custom = true
    else
        return false, 0

    if next < count and words[next] == "moves"
        for i in next + 1..count
            let move = parse_move(board, words[i])
            if move == NoMove: break
            board.play(move)
            custom = true

    let plies = board.ply
    board.discard_history()
    return custom, plies

fn parse_go(uci: *Uci, words: *str, count: int) -> bool
    var white_time: i64 = 0
    var black_time: i64 = 0
    var white_increment: i64 = 0
    var black_increment: i64 = 0
    var move_time: i64 = 0
    var nodes: i64 = 0
    var depth = 0
    var moves_to_go = 0
    var infinite = false

    for i in 1..count
        let word = words[i]
        let value = i + 1 < count ? parse_int(words[i + 1]) : 0
        if word == "infinite": infinite = true
        elif word == "depth": depth = value
        elif word == "movetime": move_time = value
        elif word == "nodes": nodes = value
        elif word == "wtime": white_time = value
        elif word == "btime": black_time = value
        elif word == "winc": white_increment = value
        elif word == "binc": black_increment = value
        elif word == "movestogo": moves_to_go = value
        elif word == "perft"
            let start = now_ms()
            let total = perft(uci.board, value, false)
            let ms = now_ms() - start
            print("Nodes searched: {total}  {ms:.0} ms  {total / max(ms, 0.001) / 1000.0:.1} Mnps")
            return false

    var limits: SearchLimits
    if infinite
        limits.until_stopped = true
    elif move_time > 0
        limits.move_time_ms = move_time
    elif nodes > 0
        limits.max_nodes = nodes
    elif depth > 0
        limits.max_depth = depth
    elif white_time > 0 or black_time > 0
        let white = uci.board.side == White
        let remaining = white ? white_time : black_time
        let increment = white ? white_increment : black_increment
        let first_move = not uci.searched_this_game and uci.custom_position
        limits = allocate_time(remaining, increment, moves_to_go, first_move)
    else
        limits.max_depth = DefaultSearchDepth
    uci.limits = limits
    return true
