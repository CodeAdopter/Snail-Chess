use root
use fen
use config

fn bench_position(i: int) -> str
    match i
        0: return "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq -"
        1: return "r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq -"
        2: return "r4rk1/1pp1qppp/p1np1n2/2b1p1B1/2B1P1b1/P1NP1N2/1PP1QPPP/R4RK1 w - - 0 10"
        3: return "r3k2r/Pppp1ppp/1b3nbN/nP6/BBP1P3/q4N2/Pp1P2PP/R2Q1RK1 w kq -"
        4: return "8/2p5/3p4/KP5r/1R3p1k/8/4P1P1/8 w - -"
    return "rnbq1k1r/pp1Pbppp/2p5/8/2B5/8/PPP1NnPP/RNBQK2R w KQ - 1 8"

fn run_bench(depth: int)
    let search = new Search
    search.suppress_output = true
    let board = new Board
    board.load_fen(StartFen)
    search.find_best_move(board, SearchLimits(max_depth: min(depth, 6)))

    var total_nodes: i64 = 0
    var total_quiescence: i64 = 0
    var total_ms: i64 = 0
    for i in 0..6
        board.load_fen(bench_position(i))
        let best = search.find_best_move(board, SearchLimits(max_depth: depth))
        total_nodes += search.last_node_count
        total_quiescence += search.last_quiescence_nodes
        total_ms += search.last_elapsed_ms
        let ms = max(search.last_elapsed_ms, 1)
        write("  d{search.last_depth:-2} {search.last_node_count:12} nodes  {search.last_elapsed_ms:6} ms  {search.last_node_count / (ms * 1000.0):6.2} Mnps  score {search.last_score:6}  bm ")
        write_move(best)
        print()
    let ms = max(total_ms, 1)
    print("bench depth {depth}: {total_nodes} nodes ({100.0 * total_quiescence / max(total_nodes, 1):.1}% q)  {total_ms} ms  {total_nodes / (ms * 1000.0):.2} Mnps")
