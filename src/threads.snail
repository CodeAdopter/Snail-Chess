use opening

fn run_helper(search: *Search)
    search.find_best_move(search.root, SearchLimits(until_stopped: true))

struct SearchThreads
    main: *Search
    helpers: [MaxThreads]*Search
    helper_threads: [MaxThreads]u64
    helper_count: int
    table: *TranspositionTable
    report_lock: int
    suppress_output: bool
    strength: Strength
    opening: *Opening
    avoid: *Memory

    start_ms: f64
    depth_limit: int
    until_stopped: bool
    deepest_depth: int
    deepest_score: int
    deepest_line: [MaximumPly]Move
    deepest_length: int

    last_node_count: i64
    last_elapsed_ms: i64
    last_score: int
    last_depth: int
    last_line: [MaximumPly]Move
    last_line_length: int

    static fn create() -> *SearchThreads
        let threads = new SearchThreads
        threads.table = new TranspositionTable
        threads.main = new Search
        threads.main.group = threads
        threads.main.table = threads.table
        threads.strength.elo = DefaultStrengthElo
        threads.opening = new Opening
        return threads

    fn thread_count() -> int
        return helper_count + 1

    fn set_threads(count: int)
        let wanted = clamp(count, 1, MaxThreads) - 1
        while helper_count < wanted
            let helper = new Search
            helper.suppress_output = true
            helper.helper_index = helper_count + 1
            helper.table = table
            helper.group = self
            helper.root = new Board
            helpers[helper_count] = helper
            helper_count += 1
        while helper_count > wanted
            helper_count -= 1
            free(helpers[helper_count].root)
            free(helpers[helper_count])

    fn clear_hash()
        table.clear()

    fn stop()
        main.stop()
        for i in 0..helper_count
            helpers[i].stop()

    fn reset_stop()
        main.stop_requested = false

    fn total_nodes() -> i64
        var nodes = atomic_load(&main.node_count)
        for i in 0..helper_count
            nodes += atomic_load(&helpers[i].node_count)
        return nodes

    fn choose_move(board: *Board, limits: SearchLimits, game_ply: int) -> Move
        let memory = &opening.memory
        if not limits.until_stopped
            let book_move = opening.book_move(board, game_ply, &strength)
            if book_move != NoMove
                last_line[0] = book_move
                last_line_length = 1
                memory.decide(board.key, book_move, game_ply)
                if not suppress_output
                    write("info string book ")
                    write_move(book_move)
                    print()
                return book_move

        avoid = memory.loaded and game_ply < MemoryPlies ? memory : null
        var move = find_best_move(board, limits)
        if not strength.limited and avoid != null and move != NoMove and memory.exploited(board.key, move)
            move = main.avoid_exploited(board, move, memory)
            last_line[0] = move
            last_line_length = 1
        avoid = null
        memory.decide(board.key, move, game_ply)
        memory.observe(strength.limited ? main.truth_score : last_score, game_ply)
        return move

    fn finish_game()
        opening.memory.finish_game()

    fn find_human_move(board: *Board, limits: SearchLimits) -> Move
        depth_limit = int.max
        deepest_depth = 0
        deepest_length = 0
        start_ms = now_ms()
        let quiet = suppress_output
        suppress_output = true
        let move = main.human_move(board, limits, &strength, avoid)
        suppress_output = quiet

        last_node_count = main.node_count
        last_elapsed_ms = (now_ms() - start_ms) as i64
        last_score = main.last_score
        last_depth = main.last_depth
        last_line_length = main.last_line_length
        copy(&last_line[0], &main.last_line[0], last_line_length)
        if not quiet and move != NoMove: print_info(last_depth, last_score, last_node_count, last_elapsed_ms, &last_line[0], last_line_length)
        return move

    fn find_best_move(board: *Board, limits: SearchLimits) -> Move
        table.new_search()
        if strength.limited: return find_human_move(board, limits)
        depth_limit = limits.max_depth > 0 ? limits.max_depth : int.max
        until_stopped = limits.until_stopped
        deepest_depth = 0
        deepest_score = 0
        deepest_length = 0
        start_ms = now_ms()

        for i in 0..helper_count
            let helper = helpers[i]
            *helper.root = *board
            helper.stop_requested = false
            helper.node_count = 0
            helper_threads[i] = spawn(run_helper, helper)

        let main_move = main.find_best_move(board, limits)

        for i in 0..helper_count
            helpers[i].stop()
        for i in 0..helper_count
            join(helper_threads[i])

        last_node_count = total_nodes()
        last_elapsed_ms = (now_ms() - start_ms) as i64
        if deepest_length == 0
            last_score = main.last_score
            last_depth = main.last_depth
            last_line_length = main.last_line_length
            copy(&last_line[0], &main.last_line[0], last_line_length)
            return main_move

        last_score = deepest_score
        last_depth = deepest_depth
        last_line_length = deepest_length
        copy(&last_line[0], &deepest_line[0], deepest_length)
        return deepest_line[0]

    fn iteration_completed(depth: int, score: int, line: *Move, length: int)
        lock(&report_lock)
        if depth > deepest_depth
            deepest_depth = depth
            deepest_score = score
            deepest_length = length
            copy(&deepest_line[0], line, length)

            if not suppress_output: print_info(depth, score, total_nodes(), (now_ms() - start_ms) as i64, line, length)

            let mate_found = abs(score) >= MateBound and not until_stopped
            if depth >= depth_limit or mate_found: stop()
        unlock(&report_lock)
