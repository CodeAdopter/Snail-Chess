use shelter

@inline
fn file_mask(files: u8) -> Bitboard
    return files as u64 * 0x0101010101010101

@inline
fn pawn_threats[us: Side](board: *Board) -> int
    const them = us.other
    let pawns = board.pieces(us, Pawn)
    let targets = board.occupancy(them) ^ board.pieces(them, Pawn) ^ board.pieces(them, King)
    return ((capture_west(pawns) | capture_east(pawns)) & targets).count

@inline
fn piece_terms(board: *Board, entry: *PawnEntry) -> Score
    let rook_files = (board.pieces(White, Rook) & ~file_mask(entry.white_files)).count - (board.pieces(Black, Rook) & ~file_mask(entry.black_files)).count
    var score = PawnThreat * (pawn_threats[White](board) - pawn_threats[Black](board))
    return score + RookFile * rook_files + king_terms(board, entry)
