use ordering
use config

@inline
fn history_bonus(depth: int) -> int
    return min(HistoryBonusSlope * depth, HistoryBonusCap)

@inline
fn played_index(board: *Board, move: Move) -> int
    return (board.squares[move.from] as int) << 6 | move.to as int

@inline
fn continuation_column(board: *Board, move: Move) -> int
    return (board.squares[move.from] >> 1) << 6 | move.to as int

@inline
fn age(entry: *i16, bonus: int)
    let value = *entry as int
    *entry = (value + bonus - value * abs(bonus) / HistoryLimit) as i16

extend Search
    fn clear_continuations()
        zero(&counter_history)
        zero(&follow_history)

    @inline
    fn history_index[us: Side](move: Move) -> int
        return (us as int) << 12 | (move.code & 4095) as int

    @inline
    fn counter_row(ply: int) -> *i16
        return &counter_history[played[ply + 1] * ContinuationColumns]

    @inline
    fn follow_row(ply: int) -> *i16
        return &follow_history[played[ply] * ContinuationColumns]

    @inline
    fn quiet_score[us: Side](board: *Board, move: Move, counter: *i16, follow: *i16) -> int
        let column = continuation_column(board, move)
        return quiet_history[history_index(move)] + counter[column] as int + follow[column] as int

    @inline
    fn update_history[us: Side](board: *Board, move: Move, ply: int, bonus: int)
        let i = history_index(move)
        quiet_history[i] += bonus - quiet_history[i] * abs(bonus) / HistoryLimit
        let column = continuation_column(board, move)
        let counter = played[ply + 1]
        if counter != NoContinuation: age(&counter_history[counter * ContinuationColumns + column], bonus)
        let follow = played[ply]
        if follow != NoContinuation: age(&follow_history[follow * ContinuationColumns + column], bonus)

    @noinline
    fn reward_quiet[us: Side](board: *Board, ply: int, depth: int, move: Move)
        remember_killer(ply, move)
        update_history(board, move, ply, history_bonus(depth))

    fn punish_quiets[us: Side](board: *Board, moves: *Move, count: int, depth: int, ply: int)
        let malus = -history_bonus(depth)
        for i in 0..count
            if moves[i].code < FirstTactical: update_history(board, moves[i], ply, malus)

    @noinline
    fn sort_by_history[us: Side](board: *Board, moves: *Move, count: int, keep: int, keys: *int, ply: int)
        let head = min(keep, count)
        let counter = counter_row(ply)
        let follow = follow_row(ply)
        for i in 0..count
            let move = moves[i]
            let key = quiet_score(board, move, counter, follow) * 256 + 255 - i
            var j = i - 1
            if i >= head
                if key < keys[head - 1]
                    keys[i] = key
                    continue
                moves[i] = moves[head - 1]
                keys[i] = keys[head - 1]
                j = head - 2
            while j >= 0 and keys[j] < key
                moves[j + 1] = moves[j]
                keys[j + 1] = keys[j]
                j -= 1
            moves[j + 1] = move
            keys[j + 1] = key

@noinline
fn sort_rest(moves: *Move, keys: *int, count: int)
    for i in 1..count
        let move = moves[i]
        let key = keys[i]
        var j = i - 1
        while j >= 0 and keys[j] < key
            moves[j + 1] = moves[j]
            keys[j + 1] = keys[j]
            j -= 1
        moves[j + 1] = move
        keys[j + 1] = key
