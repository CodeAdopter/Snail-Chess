use primitives

const PawnValue = 100
const KnightValue = 320
const BishopValue = 330
const RookValue = 500
const QueenValue = 900

const KindValue = [0, PawnValue, KnightValue, BishopValue, RookValue, QueenValue, 0]

var capture_gain: [16]int

var kind_gain: [16]int

init
    for code in 0..PieceLimit
        capture_gain[code] = KindValue[code >> 1]
    kind_gain[EnPassant] = PawnValue
    for p in 0..4
        let over_pawn = KindValue[Knight + p] - PawnValue
        kind_gain[PromoteKnight + p] = over_pawn
        kind_gain[CapturePromoteKnight + p] = over_pawn
