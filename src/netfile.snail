# Net files: what the readers of the move net (src/gnet.snail) and of the think-time net
# (src/tnet.snail) share. A net comes as its trainer writes it, or quantized: Ganglia's
# "GQUANT01" file, which holds the header of the net's own file and its parameters as half floats
# or as integers of 2 to 8 bits with a scale per row (Ganglia's src/quantized.snail has the
# format). nf_unquantized turns such a file back into the net's own, so each reader has one format
# to read.

use files

extern "fseek" fn nf_seek(file: *void, offset: int, origin: int) -> int
extern "ftell" fn nf_tell(file: *void) -> int

const NfQuantizedHeader = 32
const NfTensorHeader = 16

fn nf_i32(p: *u8) -> int
    return (p[0] as u32 | (p[1] as u32) << 8 | (p[2] as u32) << 16 | (p[3] as u32) << 24) as int

fn nf_i64(p: *u8) -> i64
    var v: u64 = 0
    for i in 0..8
        v |= (p[i] as u64) << (8 * i)
    return v as i64

# The value of an IEEE half float.
fn nf_half(h: u32) -> f32
    let sign = (h & 0x8000) << 16
    let exp = (h >> 10) & 31
    let man = h & 0x3FF
    if exp == 0
        let v = man as f32 * 0.000000059604644775390625     # 2^-24
        return sign != 0 ? -v : v
    if exp == 31: return f32.from_bits(sign | 0x7F800000 | man << 13)
    return f32.from_bits(sign | (exp + 112) << 23 | man << 13)

fn nf_is_quantized(bytes: *u8, length: i64) -> bool
    return length >= NfQuantizedHeader and bytes[0..8] as str == "GQUANT01"

# The net's own file from a quantized one: its header, then its parameters as f32, in a buffer
# the caller frees, and its size. null when the bytes are not a whole quantized net.
fn nf_unquantized(bytes: *u8, length: i64) -> (*u8, i64)
    if not nf_is_quantized(bytes, length): return null, 0
    let header = nf_i32(bytes + 12) as i64
    let floats = nf_i64(bytes + 16)
    let tensors = nf_i32(bytes + 24)
    if header < 0 or header > 4096 or floats < 0 or floats > length * 8 or NfQuantizedHeader + header > length: return null, 0
    let size = header + floats * 4
    let out = alloc[u8](max(size, 1))
    copy(out, bytes + NfQuantizedHeader, header)
    let w = (out + header) as *f32
    var at: i64 = NfQuantizedHeader + header
    var done: i64 = 0
    var good = true
    for k in 0..tensors
        if at + NfTensorHeader > length
            good = false
            break
        let count = nf_i64(bytes + at)
        let rows = nf_i32(bytes + at + 8) as i64
        let bits: int = nf_i32(bytes + at + 12)
        let whole = bits == 16 or (bits >= 2 and bits <= 8 and rows > 0 and count % rows == 0)
        if count < 0 or done + count > floats or not whole
            good = false
            break
        let stored = bits == 16 ? count * 2 : rows * 4 + (count * bits + 7) / 8
        if at + NfTensorHeader + stored > length
            good = false
            break
        let q = bytes + at + NfTensorHeader
        if bits == 16
            for i in 0..count
                w[done + i] = nf_half(q[2 * i] as u32 | (q[2 * i + 1] as u32) << 8)
        else
            # Integers of `bits` bits, packed from the low bit of each byte up; a value is
            # (its integer - top) times its row's scale.
            let top: int = (1 << (bits - 1)) - 1
            let mask: u32 = (1 as u32 << bits as u32) - 1
            let cols = count / rows
            let values = q + rows * 4
            for r in 0..rows
                let scale = f32.from_bits(nf_i32(q + r * 4) as u32)
                for c in 0..cols
                    let bit = (r * cols + c) * bits
                    var word = values[bit >> 3] as u32
                    if (bit & 7) + bits > 8: word |= (values[(bit >> 3) + 1] as u32) << 8
                    let code: int = ((word >> (bit & 7) as u32) & mask) as int
                    w[done + r * cols + c] = (code - top) as f32 * scale
        at += NfTensorHeader + stored
        done += count
    if not good or done != floats
        free(out)
        return null, 0
    return out, size

# A whole file in a buffer the caller frees, and its size; null when it cannot be read. A relative
# name is from the engine's folder (files.snail).
fn nf_read(name: str) -> (*u8, i64)
    var path: FilePath
    path.set(name)
    if path.length == 0: return null, 0
    let file = fopen(&path.bytes[0], "rb")
    if file == null: return null, 0
    nf_seek(file, 0, 2)
    let size = nf_tell(file) as i64
    nf_seek(file, 0, 0)
    let bytes = alloc[u8](max(size, 1))
    let got = fread(bytes, 1, size as u64, file) as i64
    fclose(file)
    if got != size
        free(bytes)
        return null, 0
    return bytes, size
