use endgame

var knight_ring: [64]Bitboard
var queen_state: [64 * 65]u8

@inline
fn king_danger[us: Side](board: *Board, king: Square) -> Score
    const them = us.other
    let knights = min((board.pieces(them, Knight) & knight_ring[king]).count, 2)
    let queen = queen_state[king * 65 + board.pieces(them, Queen).first] as int
    return KingDangerContext[queen * 3 + knights]

@inline
fn danger_terms(board: *Board) -> Score
    return king_danger[White](board, board.king_square(White)) - king_danger[Black](board, board.king_square(Black))

init
    for sq in 0..64
        let king = sq as Square
        let ring = king_attacks(king) | king.bit
        var knights: Bitboard = 0
        for zone in ring
            knights |= knight_attacks(zone)
        knight_ring[sq] = knights
        for queen in 0..64
            queen_state[sq * 65 + queen] = (5 - clamp(king_distance(queen as Square, king), 1, 4)) as u8
