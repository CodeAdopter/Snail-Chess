# Squares of a chess board.
#
# Square is a plain u8 with its own methods. The @inline methods fold at compile time when their
# arguments are constants, so a Square costs what a hand-written integer costs.

# A square numbered from 0 (a1) to 63 (h8), as file + 8 * rank. Adding an offset to a square
# gives a square, and the difference of two squares is a plain integer.
@ordinal
type Square = u8
    # The value that names no square. It prints as "-".
    static fn none() -> Square
        return 64

    # The square on file 0..7 (a..h) and rank 0..7 (1..8).
    @inline
    static fn at(file: int, rank: int) -> Square
        return (rank * 8 + file) as Square

    @inline
    fn file() -> int
        return self & 7

    @inline
    fn rank() -> int
        return self >> 3

    # The square's name in algebraic notation, such as "e4".
    @display
    fn name() -> str
        return SquareNames[self < 64 ? self : 64]

const SquareNames = [
    "a1", "b1", "c1", "d1", "e1", "f1", "g1", "h1",
    "a2", "b2", "c2", "d2", "e2", "f2", "g2", "h2",
    "a3", "b3", "c3", "d3", "e3", "f3", "g3", "h3",
    "a4", "b4", "c4", "d4", "e4", "f4", "g4", "h4",
    "a5", "b5", "c5", "d5", "e5", "f5", "g5", "h5",
    "a6", "b6", "c6", "d6", "e6", "f6", "g6", "h6",
    "a7", "b7", "c7", "d7", "e7", "f7", "g7", "h7",
    "a8", "b8", "c8", "d8", "e8", "f8", "g8", "h8",
    "-"]

