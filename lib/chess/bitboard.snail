# Bitboards: sets of squares, one bit per square, bit 0 for a1.
#
# @bits(Square) makes the set bits Squares: `for sq in board`, board.first, board.last and
# board.pop() give a Square, and operators with plain integers keep the Bitboard type.

use square

@bits(Square)
type Bitboard = u64

extend Square
    # The set holding only this square.
    @inline
    fn bit() -> Bitboard
        return 1 << self

const FileA: Bitboard = 0x0101010101010101
const FileB: Bitboard = 0x0202020202020202
const FileC: Bitboard = 0x0404040404040404
const FileD: Bitboard = 0x0808080808080808
const FileE: Bitboard = 0x1010101010101010
const FileF: Bitboard = 0x2020202020202020
const FileG: Bitboard = 0x4040404040404040
const FileH: Bitboard = 0x8080808080808080
const Rank1: Bitboard = 0x00000000000000FF
const Rank2: Bitboard = 0x000000000000FF00
const Rank3: Bitboard = 0x0000000000FF0000
const Rank4: Bitboard = 0x00000000FF000000
const Rank5: Bitboard = 0x000000FF00000000
const Rank6: Bitboard = 0x0000FF0000000000
const Rank7: Bitboard = 0x00FF000000000000
const Rank8: Bitboard = 0xFF00000000000000
